// Storage Cleaner product identity.
// Keep the runtime bundle identity used by the last on-device build that
// successfully completed access and displayed scan results. The visible name
// remains Storage Cleaner; only the process identity is restored for DarkSword
// compatibility testing.

PRODUCT_BUNDLE_IDENTIFIER = com.boierito.cyanide
MARKETING_VERSION = 1.1.3
CURRENT_PROJECT_VERSION = 7
INFOPLIST_KEY_CFBundleDisplayName = Storage Cleaner
INFOPLIST_KEY_CFBundleName = StorageCleaner

// Do not ship the inherited Cyanide artwork as this fork's product icon.
ASSETCATALOG_COMPILER_APPICON_NAME =
