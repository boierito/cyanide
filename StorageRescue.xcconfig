// Storage Cleaner product identity.
// The internal Xcode product intentionally remains Cyanide.app because the
// inherited target and runtime linkage depend on that binary name.

PRODUCT_BUNDLE_IDENTIFIER = com.ai.storageCleaner
MARKETING_VERSION = 1.1.0
CURRENT_PROJECT_VERSION = 4
INFOPLIST_KEY_CFBundleDisplayName = Storage Cleaner
INFOPLIST_KEY_CFBundleName = StorageCleaner

// Do not ship the inherited Cyanide artwork as this fork's product icon.
// Leaving the app-icon asset name empty lets sideloaded builds use the platform
// fallback instead of presenting the old Cyanide icon.
ASSETCATALOG_COMPILER_APPICON_NAME =
