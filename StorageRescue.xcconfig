// Storage Rescue product identity.
// Public identity/versioning is independent from upstream Cyanide. The internal
// Xcode product name intentionally stays inherited because the original target
// has linker paths tied to the Cyanide binary name.

PRODUCT_BUNDLE_IDENTIFIER = com.boierito.cyanide
MARKETING_VERSION = 1.0.2
CURRENT_PROJECT_VERSION = 3
INFOPLIST_KEY_CFBundleDisplayName = Storage Rescue
INFOPLIST_KEY_CFBundleName = StorageRescue
