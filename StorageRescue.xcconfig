// Storage Cleaner corrected progressive build.
// Keep the runtime bundle identity used by the working build. Gain Access,
// DarkSword/XPF setup, staging and solver remain inherited from the proven main
// implementation; no filesystem or LaunchServices work runs during Gain Access.

PRODUCT_BUNDLE_IDENTIFIER = com.boierito.cyanide
MARKETING_VERSION = 1.2.1
CURRENT_PROJECT_VERSION = 12
INFOPLIST_KEY_CFBundleDisplayName = Storage Cleaner
INFOPLIST_KEY_CFBundleName = StorageCleaner

// Do not ship the inherited Cyanide artwork as this fork's product icon.
ASSETCATALOG_COMPILER_APPICON_NAME =
